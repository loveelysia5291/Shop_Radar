<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ShopRadar" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3868D9</item>
        <item name="android:windowBackground">#F3F6FC</item>
        <item name="android:navigationBarColor">#F3F6FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3F6FC</item>
    </style>
    <!-- Starting window is background-only; the logo has one Compose animation. -->
    <style name="Theme.ShopRadar.Launch" parent="Theme.ShopRadar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_bars</item>
    </style>
</resources>
